{
  "id": "shell",
  "display_name": "Shell",
  "launch": {
    "program": "powershell.exe",
    "args": ["-NoLogo"]
  },
  "env_scrub_prefixes": ["ARGUS_"],
  "keys": {
    "approve": "enter",
    "deny": "ctrl-c"
  },
  "rules": [
    {
      "name": "confirm-prompt",
      "status": "needs_you",
      "pattern": "(?i)\\[Y\\] Yes|\\(y/n\\)|Are you sure",
      "priority": 100,
      "region": { "last_lines": 1 }
    },
    {
      "name": "powershell-prompt",
      "status": "idle",
      "pattern": "^PS [^\\n]*>\\s*$",
      "priority": 10,
      "region": { "last_lines": 1 }
    },
    {
      "name": "cmd-prompt",
      "status": "idle",
      "pattern": "^[A-Za-z]:\\\\[^\\n]*>\\s*$",
      "priority": 10,
      "region": { "last_lines": 1 }
    },
    {
      "name": "busy",
      "status": "working",
      "pattern": "\\S",
      "priority": 1,
      "region": { "last_lines": 1 }
    }
  ]
}
